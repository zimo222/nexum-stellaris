  - background: {fileID: 21300000, guid: bf4385054772cff45a44a800a67de44a, type: 3}
    speakerId: Player
    content: "\u201C\u4F46\u90A3\u4E9B\u5149\uFF0C\u662F\u771F\u7684\u3002\u201D"
