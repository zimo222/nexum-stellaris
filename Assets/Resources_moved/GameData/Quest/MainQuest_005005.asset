  description: "\u788E\u88C2\u58F0\u91CC\uFF0C\u5979\u4E0D\u5728\uFF0C\u8C01\u90FD\u4E0D\u5728\u3002"
  dialogueEntries:
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: 
    useCGMode: 1
  - background: {fileID: 21300000, guid: 9b51e544c1822be44a7b778bf4c1f3a6, type: 3}
    speakerId: 
    content: "\u5B83\u7AD9\u5728\u6211\u9762\u524D\u3002\u5B83\u6CA1\u6709\u56FA\u5B9A\u7684\u5F62\u72B6\u3002\u5B83\u662F\u4E00\u56E2\u96FE\uFF0C\u96FE\u91CC\u7FFB\u6EDA\u7740\u65E0\u6570\u788E\u7247\u2014\u2014\u4E94\u5C81\u90A3\u5E74\u7AD9\u5728\u96FE\u91CC\u627E\u4E0D\u5230\u56DE\u5BB6\u7684\u8DEF\uFF1B\u7EAF\u767D\u56DE\u5ECA\u91CC\u7EAF\u767D\u7684\u8EAB\u5F71\u6E10\u6E10\u53D8\u6DE1\uFF1B\u539F\u91CE\u4E0A\u5C0F\u539F\u7684\u5B57\u8FF9\u88AB\u98CE\u5439\u6563\uFF1B\u75F4\u8FF7\u5DE5\u574A\u7684\u6DF1\u591C\u753B\u4E0A\u7684\u8138\u6A21\u7CCA\u4E0D\u6E05\uFF1B\u65E0\u6570\u5C01\u4FE1\u98D8\u5411\u865A\u7A7A\u6CA1\u6709\u56DE\u97F3\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 558f7065103c7ba4cb27abbc4c1e20a2, type: 3}
    speakerId: 
    content: "\u5B83\u5411\u6211\u51B2\u6765\u3002\u6211\u4F38\u624B\u53BB\u6321\u2014\u2014\u5B83\u7684\u653B\u51FB\u7A7F\u900F\u4E86\u6211\u7684\u624B\u81C2\uFF0C\u76F4\u63A5\u51FB\u4E2D\u80F8\u53E3\u3002\u6211\u4F4E\u5934\u770B\uFF0C\u80F8\u53E3\u7684\u6E0A\u5FC3\u4E0A\uFF0C\u51FA\u73B0\u4E86\u4E00\u9053\u88C2\u75D5\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 558f7065103c7ba4cb27abbc4c1e20a2, type: 3}
    speakerId: 
    content: "\u5B83\u53C8\u4E00\u6B21\u6251\u6765\u3002\u6BCD\u4EB2\u7684\u6C89\u9ED8\u3002\u7EAF\u767D\u7684\u6D88\u5931\u3002\u5C0F\u539F\u7684\u79BB\u5F00\u3002\u58C1\u753B\u7684\u9634\u5F71\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: de2716d8bce36b54a915541b86a38b4d, type: 3}
    speakerId: "\u60D8"
    content: "\u201C\u4F60\u77E5\u9053\u5417\uFF1F\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: de2716d8bce36b54a915541b86a38b4d, type: 3}
    speakerId: "\u60D8"
    content: "\u201C\u4F60\u4E00\u76F4\u53EA\u662F\u5728\u9A97\u81EA\u5DF1\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: de2716d8bce36b54a915541b86a38b4d, type: 3}
    speakerId: "\u60D8"
    content: "\u201C\u4F60\u62FC\u547D\u753B\u5979\uFF0C\u662F\u56E0\u4E3A\u4F60\u5BB3\u6015\u5FD8\u8BB0\u3002\u4F60\u62FC\u547D\u5199\u4FE1\uFF0C\u662F\u56E0\u4E3A\u4F60\u5BB3\u6015\u88AB\u5FD8\u8BB0\u3002\u4F60\u62FC\u547D\u8D70\uFF0C\u662F\u56E0\u4E3A\u4F60\u5BB3\u6015\u505C\u4E0B\u6765\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: de2716d8bce36b54a915541b86a38b4d, type: 3}
    speakerId: 
    content: 
    useCGMode: 1
  - background: {fileID: 21300000, guid: 43059af10c03a26489b9e46b6c794978, type: 3}
    speakerId: 
    content: "\u60D8\u53C8\u4E00\u6B21\u6251\u6765\u3002\u8FD9\u4E00\u6B21\uFF0C\u5B83\u51FB\u4E2D\u4E86\u6E0A\u5FC3\u7684\u6B63\u4E2D\u592E\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 43059af10c03a26489b9e46b6c794978, type: 3}
    speakerId: 
    content: "\u788E\u88C2\u7684\u58F0\u97F3\u3002\u6E0A\u5FC3\u788E\u4E86\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 43059af10c03a26489b9e46b6c794978, type: 3}
    speakerId: 
    content: "\u6240\u6709\u7684\u5149\u70B9\u4ECE\u88C2\u75D5\u4E2D\u6D8C\u51FA\uFF0C\u98D8\u5411\u56DB\u5468\uFF0C\u7136\u540E\u7184\u706D\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 0a49881f1103a364ab30783599491526, type: 3}
    speakerId: 
    content: 
    useCGMode: 1
  - background: {fileID: 21300000, guid: 0a49881f1103a364ab30783599491526, type: 3}
    speakerId: "\u60D8"
    content: "\u201C\u4F60\u4E00\u76F4\u90FD\u77E5\u9053\u3002\u4ED6\u4EEC\u90FD\u4F1A\u79BB\u5F00\u3002\u4F60\u4E00\u76F4\u90FD\u77E5\u9053\uFF0C\u4F60\u6700\u540E\u4F1A\u4E00\u4E2A\u4EBA\u3002\u201D"
    useCGMode: 1
