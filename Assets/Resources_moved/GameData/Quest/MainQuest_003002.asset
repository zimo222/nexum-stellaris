  - background: {fileID: 21300000, guid: 03bb7ff61a0480b48b39a4b1d28ddb95, type: 3}
    speakerId: "\u5C0F\u539F"
    content: "\u201C\u4F60\u4E0D\u89C9\u5F97\u5417\uFF1F\u6BCF\u8D70\u4E00\u6B65\uFF0C\u4E16\u754C\u5C31\u5927\u4E00\u70B9\u3002\u201D"
