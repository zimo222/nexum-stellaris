  - background: {fileID: 21300000, guid: a91f21211f8436141811a632ebe21a52, type: 3}
    speakerId: 
    content: "\u5979\u5E26\u6211\u53BB\u6CB3\u8FB9\u6293\u9C7C\u3002\u5979\u5149\u7740\u811A\u7AD9\u5728\u6C34\u91CC\uFF0C\u76EF\u7740\u6C34\u9762\u4E00\u52A8\u4E0D\u52A8\uFF0C\u7136\u540E\u624B\u7A81\u7136\u4F38\u4E0B\u53BB\u2014\u2014\u4E00\u6761\u9C7C\u5C31\u98DE\u51FA\u6765\u4E86\u3002\u6211\u4E00\u6761\u90FD\u6CA1\u6293\u5230\u3002\u5979\u7B11\u6211\uFF0C\u7136\u540E\u63E1\u4F4F\u6211\u7684\u624B\u6309\u5728\u6C34\u5E95\u7684\u77F3\u5934\u4E0A\uFF0C\u6559\u6211\u770B\u6C34\u7684\u7EB9\u8DEF\u3002\u4E00\u6761\u9C7C\u4ECE\u6211\u4EEC\u624B\u8FB9\u6E38\u8FC7\u3002"
