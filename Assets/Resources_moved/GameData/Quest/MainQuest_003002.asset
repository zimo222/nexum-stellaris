  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u5979\u8D70\u5F97\u5F88\u5FEB\uFF0C\u603B\u662F\u5728\u524D\u9762\u7B49\u6211\u3002\u6211\u8FFD\u4E0A\u53BB\u7684\u65F6\u5019\uFF0C\u5979\u5DF2\u7ECF\u5728\u4E0B\u4E00\u4E2A\u5C71\u5761\u4E0A\u8EBA\u7740\u4E86\u3002"
