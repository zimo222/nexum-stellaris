  description: "\u65AD\u6389\u7684\u7B14\u5212\u5F00\u53E6\u4E00\u7247\u5929\u7A7A\u3002"
  dialogueEntries:
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u6211\u5728\u5DE5\u574A\u7684\u89D2\u843D\u91CC\u627E\u5230\u4E00\u672C\u65E7\u753B\u518C\u3002\u7FFB\u5F00\uFF0C\u91CC\u9762\u4E0D\u662F\u753B\uFF0C\u662F\u5B57\u3002"
