    controls: []
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: Player
    content: '"......"'
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: ebb493a1c7dcf994dbdbab4f8820418d, type: 3}
    speakerId: 
    content: "\u6211\u62FF\u8D77\u753B\u7B14\uFF0C\u8638\u4E86\u989C\u6599\uFF0C\u6CA1\u6709\u601D\u8003\uFF0C\u6CA1\u6709\u72B9\u8C6B\uFF0C\u76F4\u63A5\u843D\u5728\u753B\u5E03\u4E0A\u3002"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u4E0D\u662F\u5979\u7684\u8138\u3002\u662F\u7B2C\u4E09\u6839\u5ECA\u67F1\u3002\u662F\u98CE\u5439\u8D77\u5979\u5934\u53D1\u7684\u5F27\u5EA6\u3002\u662F\u5979\u7B2C\u4E00\u6B21\u8BF4\u201C\u522B\u6015\u201D\u65F6\uFF0C\u6211\u6307\u5C16\u90A3\u7F15\u5149\u3002"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: ebb493a1c7dcf994dbdbab4f8820418d, type: 3}
    speakerId: 
    content: "\u6211\u753B\u4E86\u5F88\u4E45\u3002\u4E45\u5230\u989C\u6599\u5E72\u4E86\u4E00\u5C42\u53C8\u8986\u4E0A\u4E00\u5C42\u3002\u4E45\u5230\u7A97\u5916\u9ED1\u4E86\u53C8\u4EAE\uFF0C\u4EAE\u4E86\u53C8\u9ED1\u3002"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u6700\u540E\u6211\u653E\u4E0B\u7B14\u3002"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
