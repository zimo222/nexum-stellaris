  - background: {fileID: 21300000, guid: ebb493a1c7dcf994dbdbab4f8820418d, type: 3}
    speakerId: 
    content: "\u767D\u5929\u753B\uFF0C\u665A\u4E0A\u753B\uFF0C\u753B\u5230\u989C\u6599\u5E72\u5728\u624B\u4E0A\uFF0C\u753B\u5230\u773C\u775B\u9178\u6DA9\u6D41\u6CEA\u3002"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: ebb493a1c7dcf994dbdbab4f8820418d, type: 3}
    speakerId: 
    content: "\u6709\u65F6\u5019\u753B\u7740\u753B\u7740\uFF0C\u6211\u4F1A\u5FD8\u8BB0\u65F6\u95F4\u3002\u7A97\u5916\u4ECE\u767D\u5929\u53D8\u6210\u9ED1\u591C\uFF0C\u53C8\u4ECE\u9ED1\u591C\u53D8\u6210\u767D\u5929\uFF0C\u800C\u6211\u6D51\u7136\u4E0D\u89C9\u3002\u989C\u6599\u5E72\u4E86\u53C8\u8C03\uFF0C\u8C03\u4E86\u53C8\u5E72\u3002\u753B\u5E03\u6362\u4E86\u4E00\u5F20\u53C8\u4E00\u5F20\u3002"
