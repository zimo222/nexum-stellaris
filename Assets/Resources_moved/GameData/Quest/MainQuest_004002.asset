  - background: {fileID: 21300000, guid: 29e4d7e733c78b54a90087eca41b81ae, type: 3}
    speakerId: 
    content: "\u6709\u4E00\u5929\uFF0C\u7EAF\u767D\u5750\u5728\u7A97\u8FB9\uFF0C\u770B\u7740\u6211\u753B\u753B\u3002\u9633\u5149\u4ECE\u7A97\u6237\u900F\u8FDB\u6765\uFF0C\u843D\u5728\u5979\u7684\u94F6\u767D\u8272\u5934\u53D1\u4E0A\uFF0C\u50CF\u788E\u91D1\u3002"
