  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u753B\u4E86\u5F88\u591A\u753B\uFF0C\u5B66\u4E86\u5F88\u591A\u4E1C\u897F\u3002\u6709\u4E00\u5929\uFF0C\u6211\u5FFD\u7136\u60F3\u7ED9\u5C0F\u539F\u5199\u4E00\u5C01\u4FE1\u3002\u60F3\u544A\u8BC9\u4ED6\uFF0C\u6211\u753B\u4E86\u5F88\u591A\u753B\u3002\u60F3\u95EE\u4ED6\uFF0C\u4F60\u8FD8\u8BB0\u5F97\u6211\u5417\u3002"
