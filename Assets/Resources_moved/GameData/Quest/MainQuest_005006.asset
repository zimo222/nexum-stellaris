    controls: []
  - background: {fileID: 21300000, guid: f4b8b4bc8ba3c91408f921d5741b17d1, type: 3}
    speakerId: "\u7EAF\u767D"
    content: "\u201C\u4ECE\u4ECA\u4EE5\u540E\uFF0C\u6211\u4E0D\u518D\u662F\u7AD9\u5728\u5ECA\u67F1\u65C1\u7684\u2018\u89C2\u6D4B\u8005\u2019\u3002\u6211\u662F\u4F60\u7684\u4E00\u90E8\u5206\u3002\u662F\u4F60\u6BCF\u4E00\u6B21\u5FC3\u8DF3\u91CC\uFF0C\u90A3\u4E2A\u544A\u8BC9\u4F60\u2018\u4F60\u53EF\u4EE5\u2019\u7684\u58F0\u97F3\u3002\u201D"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "(\u5979\u7684\u624B\u7A7F\u8FC7\u955C\u9762)"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u955C\u9762\u6CDB\u8D77\u6D9F\u6F2A\u3002\u5979\u7684\u624B\u4F38\u51FA\u6765\uFF0C\u94F6\u767D\u8272\u7684\u6307\u5C16\u5728\u7A7A\u6C14\u4E2D\u5FAE\u5FAE\u53D1\u5149\u3002"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u6211\u4F38\u51FA\u624B\uFF0C\u63E1\u4F4F\u5979\u7684\u624B\u3002"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u4E0D\u662F\u51C9\u7684\u3002\u662F\u6E29\u7684\u3002\u548C\u6211\u81EA\u5DF1\u7684\u4F53\u6E29\u4E00\u6A21\u4E00\u6837\u3002"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u5979\u4ECE\u955C\u4E2D\u8D70\u51FA\u6765\u3002\u94F6\u767D\u8272\u7684\u5149\u8292\u7B3C\u7F69\u7740\u5979\uFF0C\u4E5F\u7B3C\u7F69\u7740\u6211\u3002\u5979\u770B\u7740\u6211\uFF0C\u7B11\u4E86\u2014\u2014\u773C\u7736\u7EA2\u7EA2\u7684\uFF0C\u4F46\u7B11\u7740\u3002"
    useCGMode: 1
    controls: []
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: "\u7EAF\u767D"
