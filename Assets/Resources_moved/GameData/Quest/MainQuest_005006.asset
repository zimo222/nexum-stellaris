  - background: {fileID: 21300000, guid: 8767c97641823524ca0fb43abdb809d6, type: 3}
    speakerId: "\u7EAF\u767D"
    content: "\"\u4F60\u53EA\u9700\u8BB0\u5F97\uFF0C\u4F60\u4EE5\u540E\u8FD8\u4F1A\u9047\u89C1\u5F88\u591A\u4EBA\uFF0C\u4E5F\u4F1A\u548C\u5F88\u591A\u4EBA\u5206\u79BB\u3002\u6CA1\u6709\u8C01\u80FD\u4E00\u76F4\u966A\u7740\u8C01\u3002\u4F46\u90A3\u4E9B\u4E00\u8D77\u8D70\u8FC7\u7684\u65F6\u95F4\uFF0C\u8BF4\u8FC7\u7684\u8BDD\uFF0C\u7B11\u8FC7\u3001\u54ED\u8FC7\u7684\u77AC\u95F4\uFF0C\u90FD\u4F1A\u7559\u5728\u4F60\u5FC3\u91CC\u3002\u90A3\u5C31\u662F\u4F60\u4EEC\u4E4B\u95F4\u7684\u7F81\u7ECA\uFF0C\u662F\u5F7C\u6B64\u66FE\u7ECF\u5B58\u5728\u7684\u8BC1\u660E\u3002\u53EA\u8981\u4F60\u4E0D\u66FE\u5FD8\u8BB0\uFF0C\u4F60\u5C31\u4E0D\u662F\u4E00\u4E2A\u4EBA\uFF0C\u4ED6\u4EEC\u4E5F\u4ECE\u6765\u6CA1\u6709\u771F\u6B63\u79BB\u5F00\u8FC7\u3002\u201D"
