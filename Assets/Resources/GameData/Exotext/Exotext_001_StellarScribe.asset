  m_Name: Exotext_001_StellarScribe
  m_EditorClassIdentifier: 
  id: Exotext_001_StellarScribe
  exotextName: "\u8BE0\u661F\u6756 \xB7 \u75F4\u8FF7\u4E4B\u7B14"
  type: 4
  element: 
  baseStars: 0
  maxStars: 0
  baseHealth: 0
  baseAttack: 0
  baseDefence: 0
  baseEnergy: 0
  baseCritRate: 0
  baseCritDamage: 0
  baseElementBonus: 0
  icon: {fileID: 0}
  introduction: "\u4E00\u67C4\u4EE5\u661F\u8FB0\u788E\u7247\u4E3A\u7B14\u5C16\u7684\u6CD5\u6756\uFF0C\u6756\u8EAB\u7531\u51DD\u56FA\u7684\u70ED\u7231\u94F8\u6210\u3002\u6325\u52A8\u65F6\uFF0C\u4F1A\u7559\u4E0B\u6DE1\u6DE1\u7684\u661F\u8F68\uFF0C\u5982\u540C\u5728\u865A\u7A7A\u4E2D\u4E66\u5199\u3002\u65BD\u6CD5\u65F6\uFF0C\u6756\u5C16\u4F1A\u6D6E\u73B0\u51FA\u53EA\u6709\u4F7F\u7528\u8005\u80FD\u770B\u89C1\u7684\u6587\u5B57\u2014\u2014\u90A3\u662F\u5B87\u5B99\u6B63\u5728\u5BF9\u4ED6\u4F4E\u8BED\u7684\u8BD7\u53E5\u3002"
  description: "\u70ED\u7231\u662F\u4E00\u79CD\u8BED\u8A00\uFF0C\u5C06\u5185\u5FC3\u65E0\u6CD5\u8A00\u8BF4\u7684\u6FC0\u60C5\uFF0C\u7FFB\u8BD1\u6210\u53EF\u89C1\u7684\u521B\u9020\u3002\u4E3B\u89D2\u7B2C\u4E00\u6B21\u5B8C\u5168\u6C89\u6D78\u4E8E\u81EA\u5DF1\u7684\u70ED\u7231\u4E2D\uFF0C\u5FD8\u8BB0\u4E86\u65F6\u95F4\u6D41\u901D\u2014\u2014\u5F53\u4ED6\u62AC\u5934\u65F6\uFF0C\u53D1\u73B0\u661F\u7A7A\u4F3C\u4E4E\u6BD4\u5E73\u65F6\u66F4\u4EAE\u3002\u90A3\u4E00\u523B\u4ED6\u660E\u767D\uFF1A\u4E16\u754C\u4E0D\u53EA\u662F\u7528\u6765\u7406\u89E3\u7684\uFF0C\u4E5F\u662F\u7528\u6765\u4E66\u5199\u7684\u3002"
