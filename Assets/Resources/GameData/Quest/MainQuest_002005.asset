  description: "\u9501\u94FE\u7F20\u7740\u540C\u4E00\u6839\u9501\u9AA8\uFF0C\u955C\u5B50\u91CC\u3002"
  dialogueEntries:
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u7EAF\u767D\u56DE\u5ECA\u7684\u6DF1\u5904\uFF0C\u6709\u4E00\u7247\u533A\u57DF\u5979\u6CA1\u6709\u5E26\u6211\u53BB\u8FC7\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: baa0dc9c7205ab14f85c7ad4dd79386c, type: 3}
    speakerId: 
    content: "\u6709\u4E00\u5929\u8D81\u5979\u4E0D\u6CE8\u610F\uFF0C\u6211\u62D0\u8FDB\u4E86\u4E00\u6761\u5C94\u8DEF\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 383d673ad65f97f4ca790a815d062cad, type: 3}
    speakerId: 
    content: "\u8D70\u4E86\u5F88\u4E45\uFF0C\u5468\u56F4\u7684\u5ECA\u67F1\u5F00\u59CB\u53D8\u65E7\uFF0C\u6709\u4E9B\u751A\u81F3\u65AD\u88C2\u4E86\u3002\u5149\u7EBF\u4E5F\u6697\u4E0B\u6765\uFF0C\u4E0D\u50CF\u524D\u9762\u90A3\u4E48\u660E\u4EAE\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: f1aeaca480c552546b9c34bee763b8d9, type: 3}
    speakerId: 
    content: "\u770B\u89C1\u4E00\u9762\u5899\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: f1aeaca480c552546b9c34bee763b8d9, type: 3}
    speakerId: 
    content: "\u5899\u4E0A\u6709\u4E00\u5E45\u58C1\u753B\u3002\u753B\u7684\u662F\u4E00\u4E2A\u5973\u5B69\uFF0C\u94F6\u767D\u8272\u7684\u957F\u53D1\uFF0C\u6E5B\u84DD\u7684\u773C\u77B3\u2014\u2014\u548C\u7EAF\u767D\u4E00\u6A21\u4E00\u6837\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: f1aeaca480c552546b9c34bee763b8d9, type: 3}
    speakerId: 
    content: "\u4F46\u5979\u4E0D\u662F\u7AD9\u5728\u56DE\u5ECA\u91CC\u3002\u5979\u88AB\u9501\u94FE\u6346\u7740\uFF0C\u8DEA\u5728\u4E00\u4E2A\u796D\u575B\u4E0A\uFF0C\u4F4E\u7740\u5934\u3002\u5468\u56F4\u7AD9\u7740\u4E09\u4E2A\u4EBA\uFF0C\u6A21\u7CCA\u7684\u8EAB\u5F71\uFF0C\u4ED6\u4EEC\u7684\u624B\u90FD\u6307\u5411\u5979\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: f1aeaca480c552546b9c34bee763b8d9, type: 3}
    speakerId: 
    content: "\u58C1\u753B\u4E0B\u9762\u6709\u4E00\u884C\u5B57\uFF0C\u5DF2\u7ECF\u6A21\u7CCA\u4E0D\u6E05\u3002\u6211\u53EA\u80FD\u8BA4\u51FA\u51E0\u4E2A\u5B57\uFF1A"
    useCGMode: 1
  - background: {fileID: 21300000, guid: f1aeaca480c552546b9c34bee763b8d9, type: 3}
    speakerId: Player
    content: "\u201C\u2026\u2026\u796D\u2026\u2026\u613F\u2026\u2026\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: f1aeaca480c552546b9c34bee763b8d9, type: 3}
    speakerId: 
    content: "\u58C1\u753B\u65C1\u8FB9\uFF0C\u6709\u4E00\u9762\u7834\u788E\u7684\u955C\u5B50\u3002\u6211\u7ECF\u8FC7\u65F6\uFF0C\u77A5\u89C1\u81EA\u5DF1\u7684\u5012\u5F71\uFF0C\u4E0E\u58C1\u753B\u4E0A\u7684\u8138\u91CD\u53E0\u4E86\u4E00\u77AC\u95F4\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: c4ad542c01dc7ed48aa38836fedeb8c5, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4F60\u600E\u4E48\u5728\u8FD9\u91CC\uFF1F\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: c4ad542c01dc7ed48aa38836fedeb8c5, type: 3}
    speakerId: 
    content: "\u56DE\u5934\uFF0C\u5979\u7AD9\u5728\u4E0D\u8FDC\u5904\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: c4ad542c01dc7ed48aa38836fedeb8c5, type: 3}
    speakerId: Player
    content: "\u201C\u8FD9\u662F\u8C01\uFF1F\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: c4ad542c01dc7ed48aa38836fedeb8c5, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4E0D\u77E5\u9053\u3002\u6211\u6765\u7684\u65F6\u5019\uFF0C\u5B83\u5C31\u5728\u8FD9\u91CC\u4E86\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: c4ad542c01dc7ed48aa38836fedeb8c5, type: 3}
    speakerId: Player
    content: "\u201C\u53EF\u662F\u5979\u957F\u5F97\u548C\u4F60\u2014\u2014\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: c4ad542c01dc7ed48aa38836fedeb8c5, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u5DE7\u5408\u5427\u3002\u56DE\u5ECA\u91CC\u5F88\u591A\u4E1C\u897F\u6211\u90FD\u89E3\u91CA\u4E0D\u4E86\u3002\u8D70\u5427\uFF0C\u524D\u9762\u4E0D\u80FD\u53BB\u4E86\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: c4ad542c01dc7ed48aa38836fedeb8c5, type: 3}
    speakerId: 
    content: "\u5979\u8F6C\u8EAB\u5F80\u56DE\u8D70\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: c4ad542c01dc7ed48aa38836fedeb8c5, type: 3}
    speakerId: 
    content: "\u8DDF\u4E0A\u53BB\u3002\u4F46\u8D70\u4E86\u51E0\u6B65\uFF0C\u6211\u56DE\u5934\u53C8\u770B\u4E86\u4E00\u773C\u90A3\u5E45\u58C1\u753B\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: 
    useCGMode: 1
