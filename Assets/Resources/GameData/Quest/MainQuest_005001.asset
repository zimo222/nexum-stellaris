  description: "\u4E07\u7269\u55E1\u9E23\uFF0C\u53EA\u6B64\u4E00\u65B9\u5BC2\u9759\u3002"
  dialogueEntries:
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u6211\u8D70\u4E86\u5F88\u4E45\u3002\u8D70\u8FC7\u75F4\u8FF7\u5DE5\u574A\uFF0C\u8D70\u8FC7\u521D\u840C\u539F\u91CE\uFF0C\u8D70\u8FC7\u7EAF\u767D\u56DE\u5ECA\u3002"
  - background: {fileID: 21300000, guid: 348e1494898ced348a77295733eba1e6, type: 3}
    speakerId: 
    content: "\u6709\u4E00\u5929\uFF0C\u6211\u8D70\u5230\u4E00\u5EA7\u5927\u5385\u3002\u5F88\u5927\uFF0C\u5927\u5F97\u770B\u4E0D\u89C1\u8FB9\u9645\u3002\u5F88\u9AD8\uFF0C\u9AD8\u5F97\u770B\u4E0D\u89C1\u7A79\u9876\u3002\u5F88\u7A7A\uFF0C\u7A7A\u5F97\u53EA\u6709\u56DE\u58F0\u3002\u4F46\u8D70\u8FDB\u53BB\u7684\u90A3\u4E00\u523B\uFF0C\u6211\u542C\u89C1\u4E86\u65E0\u6570\u58F0\u97F3\u3002"
  - background: {fileID: 21300000, guid: 348e1494898ced348a77295733eba1e6, type: 3}
    speakerId: 
    content: "\u5FC3\u8DF3\u58F0\u3001\u547C\u5438\u58F0\u3001\u811A\u6B65\u58F0\u3001\u8BF4\u8BDD\u58F0\u3001\u7B11\u58F0\u3001\u54ED\u58F0\u3001\u98CE\u58F0\u3001\u96E8\u58F0\u3001\u661F\u661F\u8F6C\u52A8\u7684\u58F0\u97F3\u3001\u8BB0\u5FC6\u6D41\u6DCC\u7684\u58F0\u97F3\u3002"
  - background: {fileID: 21300000, guid: 348e1494898ced348a77295733eba1e6, type: 3}
    speakerId: 
    content: "\u6240\u6709\u7684\u58F0\u97F3\u6DF7\u5728\u4E00\u8D77\uFF0C\u4E0D\u662F\u5608\u6742\uFF0C\u662F\u5171\u9E23\u3002"
  - background: {fileID: 21300000, guid: 80f9039476837de4f923aa7c8bfaad8a, type: 3}
    speakerId: 
    content: "\u6211\u4F4E\u5934\u770B\u81EA\u5DF1\u7684\u80F8\u53E3\u3002\u6E0A\u5FC3\u5728\u53D1\u5149\u3002\u90A3\u5149\u91CC\uFF0C\u6709\u7236\u6BCD\uFF0C\u6709\u5C0F\u539F\uFF0C\u6709\u753B\u661F\u7A7A\u7684\u5973\u5B69\uFF0C\u6709\u89C2\u661F\u7684\u8001\u4EBA\uFF0C\u6709\u5531\u7AE5\u8C23\u7684\u5B69\u5B50\uFF0C\u6709\u65E0\u6570\u6211\u9047\u89C1\u8FC7\u7684\u4EBA\u3002\u4ED6\u4EEC\u90FD\u5728\u3002\u4E00\u5C42\u4E00\u5C42\uFF0C\u4E00\u5708\u4E00\u5708\u3002"
  - background: {fileID: 21300000, guid: eceb32d4b47467a4f86fbcdaec152920, type: 3}
    speakerId: 
    content: "\u56DE\u5934\u770B\u3002\u6765\u65F6\u7684\u8DEF\u88AB\u94F6\u767D\u8272\u7684\u5149\u70B9\u70B9\u4EAE\u4E86\uFF0C\u4E00\u9897\u4E00\u9897\uFF0C\u50CF\u661F\u661F\u843D\u5728\u5730\u4E0A\u3002\u90A3\u4E9B\u5149\u70B9\u4E0D\u53EA\u662F\u6211\u7684\u3002\u8FD8\u6709\u7236\u6BCD\u7684\uFF0C\u5C0F\u539F\u7684\uFF0C\u7EAF\u767D\u7684\uFF0C\u65E0\u6570\u964C\u751F\u4EBA\u7684\u3002\u6709\u7684\u4EAE\uFF0C\u6709\u7684\u6697\uFF0C\u6709\u7684\u8FD1\uFF0C\u6709\u7684\u8FDC\u3002"
  - background: {fileID: 21300000, guid: eceb32d4b47467a4f86fbcdaec152920, type: 3}
    speakerId: 
    content: "\u6240\u6709\u7684\u5149\u70B9\u6C47\u5728\u4E00\u8D77\uFF0C\u6210\u4E86\u540C\u4E00\u6761\u8DEF\u3002"
  - background: {fileID: 21300000, guid: eceb32d4b47467a4f86fbcdaec152920, type: 3}
    speakerId: 
    content: "\u90A3\u4E9B\u5149\u70B9\u4E2D\uFF0C\u6709\u4E00\u4E9B\u6B63\u5728\u53D8\u6697\u3002\u4E0D\u662F\u6D88\u5931\uFF0C\u662F\u6697\u4E0B\u53BB\u3002\u6709\u4E00\u4E2A\u65B9\u5411\uFF0C\u751A\u81F3\u5B8C\u5168\u9ED1\u4E86\u3002"
  objectives: []
  waves: []
  Reward: []
