  - background: {fileID: 21300000, guid: ce85d93fdeacb98498dbd5dd836a7099, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u505A\u5669\u68A6\u4E86\uFF1F\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: ce85d93fdeacb98498dbd5dd836a7099, type: 3}
    speakerId: 
    content: "\u70B9\u5934\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 7eaadc6eb8c963e4a9d1be872d535f23, type: 3}
    speakerId: 
    content: "\u5979\u4F38\u51FA\u624B\uFF0C\u63E1\u4E86\u63E1\u6211\u7684\u624B\u3002\u90A3\u53EA\u624B\u5F88\u51C9\uFF0C\u51C9\u5F97\u50CF\u6708\u5149\u3002"
