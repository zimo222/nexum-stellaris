  description: "\u68A6\u91CC\u6C89\u4E0B\u53BB\u7684\u97F3\u8282\uFF0C\u672A\u80FD\u635E\u8D77\u3002"
  dialogueEntries:
  - background: {fileID: 21300000, guid: beaaed0f691889642a152aa387494e9e, type: 3}
    speakerId: 
    content: "\u90A3\u5929\u665A\u4E0A\uFF0C\u6211\u5728\u68A6\u91CC\u53C8\u770B\u89C1\u90A3\u4E2A\u96FE\u3002\u4F46\u8FD9\u4E00\u6B21\uFF0C\u96FE\u91CC\u6709\u4E00\u4E2A\u94F6\u767D\u8272\u7684\u5F71\u5B50\uFF0C\u80CC\u5BF9\u7740\u6211\uFF0C\u8D8A\u8D70\u8D8A\u8FDC\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: beaaed0f691889642a152aa387494e9e, type: 3}
    speakerId: 
    content: "\u6211\u60F3\u8FFD\u4E0A\u53BB\uFF0C\u4F46\u817F\u8FC8\u4E0D\u52A8\u3002\u6211\u60F3\u558A\u5979\u7684\u540D\u5B57\uFF0C\u4F46\u53D1\u73B0\u81EA\u5DF1\u2014\u2014\u60F3\u4E0D\u8D77\u5979\u7684\u540D\u5B57\u4E86\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: ce85d93fdeacb98498dbd5dd836a7099, type: 3}
    speakerId: 
    content: "\u60CA\u9192\u65F6\uFF0C\u5979\u5750\u5728\u6211\u65C1\u8FB9\uFF0C\u770B\u7740\u6211\u3002"
