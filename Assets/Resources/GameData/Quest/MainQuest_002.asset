  - background: {fileID: 0}
    speakerId: 
    content: "\u96FE\u91CC\uFF0C\u6CA1\u6709\u8DEF\uFF0C\u6CA1\u6709\u58F0\u97F3\uFF0C\u558A\u4E0D\u51FA\u58F0\u3002\u6211\u62FC\u547D\u8DD1\uFF0C\u4F46\u811A\u4E0B\u4EC0\u4E48\u90FD\u6CA1\u6709\uFF0C\u50CF\u8E29\u5728\u865A\u7A7A\u91CC\u3002"
  - background: {fileID: 0}
