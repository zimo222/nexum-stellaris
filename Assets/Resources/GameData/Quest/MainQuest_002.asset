    content: '"......"'
  - background: {fileID: 0}
    speakerId: 
    content: "\u60CA\u9192\u65F6\uFF0C\u6211\u53D1\u73B0\u6307\u5C16\u6709\u4E00\u7F15\u5FAE\u5F31\u7684\u5149\u3002\u5F88\u7EC6\uFF0C\u5F88\u6DE1\uFF0C\u50CF\u8424\u706B\u866B\u7684\u5C3E\u5DF4\u3002\u4F46\u5B83\u70EB\u70EB\u7684\uFF0C\u50CF\u521A\u521A\u88AB\u8C01\u63E1\u8FC7\u3002"
  - background: {fileID: 0}
    speakerId: 
    content: "\u5B83\u6CA1\u6709\u4EFB\u4F55\u529B\u91CF\u3002\u53EA\u5728\u6700\u5B64\u72EC\u7684\u65F6\u5019\uFF0C\u63D0\u9192\u6211\uFF1A\u4F60\u66FE\u88AB\u8FD9\u6837\u63E1\u7D27\u8FC7\u3002"
