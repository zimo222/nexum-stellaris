  description: "\u7A7A\u767D\u9875\u91CC\u8D70\u51FA\u7684\u4EBA\uFF0C\u662F\u81EA\u5DF1\u3002"
  dialogueEntries:
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "(\u60D8\u8282\u8282\u8D25\u9000)"
  - background: {fileID: 21300000, guid: 037c9ae803ad01c4da201ae7ca4fe1c0, type: 3}
    speakerId: Player
    content: "\u201C\u4F60\u8BF4\u5F97\u5BF9\u3002\u6211\u5BB3\u6015\u5B64\u72EC\u3002\u6211\u5BB3\u6015\u88AB\u5FD8\u8BB0\u3002\u6211\u5BB3\u6015\u4ECE\u6765\u90FD\u4E0D\u662F\u8C01\u91CD\u8981\u7684\u4EBA\u3002\u201D"
  - background: {fileID: 21300000, guid: 037c9ae803ad01c4da201ae7ca4fe1c0, type: 3}
    speakerId: Player
    content: "\u201C\u4F46\u90A3\u4E9B\u5149\uFF0C\u662F\u771F\u7684\u3002\u201D"
  - background: {fileID: 21300000, guid: ec7a0c490eacc6449acd8e94ca9b512f, type: 3}
    speakerId: 
    content: 
  - background: {fileID: 21300000, guid: ec7a0c490eacc6449acd8e94ca9b512f, type: 3}
    speakerId: 
    content: "\u6211\u4F38\u51FA\u624B\uFF0C\u89E6\u78B0\u90A3\u56E2\u96FE\u3002\u6307\u5C16\u78B0\u5230\u7684\u5730\u65B9\uFF0C\u96FE\u6563\u5F00\u4E00\u70B9\uFF0C\u9732\u51FA\u91CC\u9762\u7684\u4E1C\u897F\u2014\u2014\u662F\u4E00\u9762\u955C\u5B50\u3002"
  - background: {fileID: 21300000, guid: ec7a0c490eacc6449acd8e94ca9b512f, type: 3}
    speakerId: 
    content: "\u955C\u5B50\u91CC\uFF0C\u662F\u4E94\u5C81\u7684\u6211\u3002\u8E72\u5728\u90A3\u91CC\uFF0C\u62B1\u7740\u819D\u76D6\uFF0C\u5C0F\u58F0\u5730\u54ED\u3002"
  - background: {fileID: 21300000, guid: e88931a02f6cfc449a154ffacc81b6c5, type: 3}
    speakerId: 
    content: 
  - background: {fileID: 21300000, guid: e88931a02f6cfc449a154ffacc81b6c5, type: 3}
    speakerId: Player
    content: "\u201C\u522B\u6015\u3002\u6211\u5728\u3002\u201D"
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: 
  - background: {fileID: 21300000, guid: b9e6c99a04252624096c5ac0f48c6d0a, type: 3}
    speakerId: 
    content: "\u60D8\u6D88\u5931\u4E86\u3002"
  - background: {fileID: 21300000, guid: b9e6c99a04252624096c5ac0f48c6d0a, type: 3}
    speakerId: 
    content: "\u4E0D\u662F\u88AB\u6253\u8D25\uFF0C\u662F\u88AB\u63A5\u7EB3\u3002"
  - background: {fileID: 21300000, guid: b9e6c99a04252624096c5ac0f48c6d0a, type: 3}
    speakerId: 
    content: "\u6240\u6709\u7684\u96FE\u6563\u5C3D\u3002\u5927\u5385\u6062\u590D\u4E86\u539F\u6765\u7684\u6837\u5B50\u3002"
  - background: {fileID: 21300000, guid: b9e6c99a04252624096c5ac0f48c6d0a, type: 3}
    speakerId: 
    content: "\u56DE\u5934\u770B\u3002\u6240\u6709\u7684\u5149\u70B9\u90FD\u91CD\u65B0\u4EAE\u4E86\u8D77\u6765\u3002\u6BD4\u4E4B\u524D\u66F4\u4EAE\u3002"
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: "\u624B\u91CC\u591A\u4E86\u4E00\u672C\u4E66\u3002\u5C01\u9762\u7EAF\u767D\u8272\uFF0C\u6CA1\u6709\u4EFB\u4F55\u6587\u5B57\u3002\u7FFB\u5F00\uFF0C\u662F\u7A7A\u767D\u7684\u3002"
  - background: {fileID: 21300000, guid: 99f522bbdb2d2844fb86e66b22574cba, type: 3}
    speakerId: 
    content: "\u5F53\u6211\u56DE\u60F3\u5979\u7684\u65F6\u5019\uFF0C\u4E66\u9875\u4E0A\u81EA\u52A8\u6D6E\u73B0\u51FA\u753B\u9762\u2014\u2014\u7B2C\u4E00\u6B21\u76F8\u9047\uFF0C\u5979\u7AD9\u5728\u5ECA\u67F1\u65C1\uFF0C\u95EE\u201C\u4F60\u8FF7\u8DEF\u4E86\u5417\u201D\uFF1B\u7B2C\u4E00\u6B21\u5FAE\u7B11\uFF0C\u6211\u6454\u5012\u4E86\u81EA\u5DF1\u722C\u8D77\u6765\uFF0C\u5979\u7B11\u4E86\u4E00\u4E0B\uFF1B\u7B2C\u4E00\u6B21\u63E1\u624B\uFF0C\u5728\u7EAF\u767D\u56DE\u5ECA\u7684\u90A3\u4E2A\u591C\u665A\uFF1B\u7B2C\u4E00\u6B21\u62E5\u62B1\uFF0C\u5979\u8BF4\u201C\u6211\u53EA\u80FD\u966A\u4F60\u5230\u8FD9\u91CC\u4E86\u201D\uFF0C\u7136\u540E\u6D88\u5931\u3002"
  - background: {fileID: 21300000, guid: 99f522bbdb2d2844fb86e66b22574cba, type: 3}
    speakerId: 
    content: "\u6240\u6709\u7684\u56DE\u5FC6\uFF0C\u4E00\u9875\u4E00\u9875\u3002"
  - background: {fileID: 21300000, guid: 15ad872fd4d39ba439031f9e00a7e8f7, type: 3}
    speakerId: 
    content: "\u6700\u540E\u4E00\u9875\u3002\u7A7A\u767D\u3002"
  - background: {fileID: 21300000, guid: 15ad872fd4d39ba439031f9e00a7e8f7, type: 3}
    speakerId: 
    content: "\u6211\u62FF\u8D77\u7B14\u3002\u60F3\u4E86\u5F88\u4E45\uFF0C\u6211\u5199\u4E0B\u4E24\u4E2A\u5B57\u3002"
  - background: {fileID: 21300000, guid: 15ad872fd4d39ba439031f9e00a7e8f7, type: 3}
    speakerId: 
    content: "\u90A3\u4E24\u4E2A\u5B57\u843D\u5728\u7EB8\u4E0A\uFF0C\u6D88\u5931\u4E86\u3002\u6574\u9875\u7EB8\u5F00\u59CB\u53D1\u5149\uFF0C\u94F6\u767D\u8272\u7684\u5149\u3002"
  - background: {fileID: 21300000, guid: 8a2d45f3e3185c24f8c1e4b8141a7a47, type: 3}
    speakerId: 
    content: 
  - background: {fileID: 21300000, guid: 72ff1f47c01b662459660fcbe0e9fb5a, type: 3}
    speakerId: 
    content: 
