    speakerId: Player
    content: "\u201C\u4E3A\u4EC0\u4E48\uFF1F\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 52fcca12ffb3bcd4fa5172fde0148246, type: 3}
    speakerId: "\u5C0F\u539F"
    content: "\u201C\u56E0\u4E3A\u6211\u8FD8\u6709\u4E8B\u8981\u505A\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 52fcca12ffb3bcd4fa5172fde0148246, type: 3}
    speakerId: "\u5C0F\u539F"
    content: "\u201C\u6211\u79BB\u5F00\u5BB6\u7684\u65F6\u5019\uFF0C\u6CA1\u6709\u8DDF\u4EFB\u4F55\u4EBA\u8BF4\u3002\u6211\u7238\u5988\u53EF\u80FD\u8FD8\u5728\u627E\u6211\u3002\u201D"
