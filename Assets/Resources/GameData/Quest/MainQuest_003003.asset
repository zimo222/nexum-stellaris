  - background: {fileID: 21300000, guid: f9705936c74533a419361e7f7ad64f99, type: 3}
    speakerId: Player
    content: "\u201C\u65E0\u8BBA\u4EE5\u540E\u5728\u54EA\u91CC\uFF0C\u65E0\u8BBA\u8FC7\u4E86\u591A\u4E45\uFF0C\u90FD\u8981\u8BB0\u5F97\u2014\u2014\u66FE\u7ECF\u6709\u4E2A\u4EBA\uFF0C\u966A\u4F60\u8D70\u8FC7\u8FD9\u7247\u539F\u91CE\u3002\u201D"
