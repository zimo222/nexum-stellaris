    content: "\u201C\u662F\u4F60\u5FC3\u91CC\u6700\u6DF1\u7684\u5730\u65B9\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 7ad4f3a1247562440a6566c171ad4fbc, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4F60\u7EC8\u4E8E\u8D70\u5230\u8FD9\u91CC\u4E86\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 7ad4f3a1247562440a6566c171ad4fbc, type: 3}
    speakerId: Player
    content: "\u201C\u8FD9\u4E9B\u58C1\u753B\u2026\u2026\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 7ad4f3a1247562440a6566c171ad4fbc, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u90FD\u662F\u4F60\u4E0D\u6562\u770B\u7684\u8BB0\u5FC6\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 7ad4f3a1247562440a6566c171ad4fbc, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4F60\u4E00\u76F4\u5728\u9003\u3002\u4ECE\u6211\u8EAB\u4E0A\u9003\uFF0C\u4ECE\u4ED6\u4EEC\u8EAB\u4E0A\u9003\uFF0C\u4ECE\u81EA\u5DF1\u8EAB\u4E0A\u9003\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 7ad4f3a1247562440a6566c171ad4fbc, type: 3}
    speakerId: Player
    content: "\u201C\u6211\u2026\u2026\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 7ad4f3a1247562440a6566c171ad4fbc, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u6CA1\u5173\u7CFB\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 7ad4f3a1247562440a6566c171ad4fbc, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u9003\u4E86\u8FD9\u4E48\u4E45\uFF0C\u5F88\u7D2F\u5427\uFF1F\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 7ad4f3a1247562440a6566c171ad4fbc, type: 3}
