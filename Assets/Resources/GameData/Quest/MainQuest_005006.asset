  - background: {fileID: 21300000, guid: 7ad4f3a1247562440a6566c171ad4fbc, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4F60\u77E5\u9053\u6211\u662F\u8C01\u5417\uFF1F\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 7ad4f3a1247562440a6566c171ad4fbc, type: 3}
