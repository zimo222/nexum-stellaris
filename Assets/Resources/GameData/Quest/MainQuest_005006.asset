  - background: {fileID: 21300000, guid: 0687d895e1af74642b70e706f376d195, type: 3}
    speakerId: 
    content: 
    useCGMode: 1
  - background: {fileID: 21300000, guid: 0687d895e1af74642b70e706f376d195, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4F60\u4ECE\u51FA\u751F\u5C31\u8BA4\u8BC6\u6211\u4E86\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 0687d895e1af74642b70e706f376d195, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u6211\u662F\u4F60\u5FC3\u91CC\u90A3\u4E2A\u2018\u7406\u60F3\u4E2D\u7684\u81EA\u5DF1\u2019\u3002\u90A3\u4E2A\u4E0D\u4F1A\u5BB3\u6015\u88AB\u9057\u5FD8\u7684\u4EBA\u3002\u90A3\u4E2A\u8DB3\u591F\u575A\u5F3A\u3001\u53EF\u4EE5\u72EC\u81EA\u8D70\u4E0B\u53BB\u7684\u4EBA\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 0687d895e1af74642b70e706f376d195, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4F60\u628A\u6211\u5851\u9020\u6210\u2018\u89C2\u6D4B\u8005\u2019\uFF0C\u5851\u9020\u6210\u2018\u5411\u5BFC\u2019\uFF0C\u5851\u9020\u6210\u4E00\u4E2A\u6C38\u8FDC\u4E0D\u4F1A\u79BB\u5F00\u4F60\u7684\u5F71\u5B50\u3002\u7136\u540E\u4F60\u628A\u6211\u9501\u5728\u796D\u575B\u4E0A\uFF0C\u4EE5\u4E3A\u8FD9\u6837\u5C31\u80FD\u6C38\u8FDC\u7559\u4F4F\u6211\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 0687d895e1af74642b70e706f376d195, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4F46\u4F60\u7559\u4E0D\u4F4F\u7684\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 0687d895e1af74642b70e706f376d195, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u56E0\u4E3A\u6211\u4E0D\u662F\u53E6\u4E00\u4E2A\u4EBA\u3002\u6211\u662F\u4F60\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 0687d895e1af74642b70e706f376d195, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u90A3\u4E9B\u9501\u94FE\uFF0C\u662F\u4F60\u5BF9\u81EA\u5DF1\u7684\u6346\u7ED1\u3002\u4F60\u4EE5\u4E3A\u53EA\u8981\u628A\u6211\u9501\u4F4F\uFF0C\u4F60\u5C31\u4E0D\u4F1A\u5931\u53BB\u6211\u3002\u4F46\u4F60\u5931\u53BB\u7684\uFF0C\u662F\u4F60\u81EA\u5DF1\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 16601ecd273b5b040948bba2c3c0638a, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4F60\u770B\u770B\u6211\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 16601ecd273b5b040948bba2c3c0638a, type: 3}
    speakerId: 
    content: 
    useCGMode: 1
  - background: {fileID: 21300000, guid: 16601ecd273b5b040948bba2c3c0638a, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4F60\u518D\u770B\u770B\u4F60\u81EA\u5DF1\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: cf84891e2aaaaa54099be44f9ccea4da, type: 3}
    speakerId: 
    content: 
    useCGMode: 1
  - background: {fileID: 21300000, guid: cf84891e2aaaaa54099be44f9ccea4da, type: 3}
    speakerId: 
    content: "(\u5979\u4E0D\u518D\u662F\u201C\u7EAF\u767D\u201D\u3002\u5979\u662F\u6211\u3002)"
    useCGMode: 1
  - background: {fileID: 21300000, guid: cf84891e2aaaaa54099be44f9ccea4da, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4F60\u660E\u767D\u4E86\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: cf84891e2aaaaa54099be44f9ccea4da, type: 3}
    speakerId: Player
    content: "\u201C\u6211\u2026\u2026\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: cf84891e2aaaaa54099be44f9ccea4da, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4E0D\u8981\u6015\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: cf84891e2aaaaa54099be44f9ccea4da, type: 3}
    speakerId: 
    content: "\u5979\u7684\u58F0\u97F3\u6BD4\u4EFB\u4F55\u65F6\u5019\u90FD\u6E29\u67D4"
    useCGMode: 1
  - background: {fileID: 21300000, guid: cf84891e2aaaaa54099be44f9ccea4da, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u6211\u4E0D\u662F\u8981\u79BB\u5F00\u4F60\u3002\u6211\u662F\u8981\u56DE\u5230\u4F60\u5FC3\u91CC\u3002\u56DE\u5230\u6211\u5E94\u8BE5\u5728\u7684\u5730\u65B9\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: cf84891e2aaaaa54099be44f9ccea4da, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u4ECE\u4ECA\u4EE5\u540E\uFF0C\u6211\u4E0D\u518D\u662F\u7AD9\u5728\u5ECA\u67F1\u65C1\u7684\u2018\u89C2\u6D4B\u8005\u2019\u3002\u6211\u662F\u4F60\u7684\u4E00\u90E8\u5206\u3002\u662F\u4F60\u6BCF\u4E00\u6B21\u5FC3\u8DF3\u91CC\uFF0C\u90A3\u4E2A\u544A\u8BC9\u4F60\u2018\u4F60\u53EF\u4EE5\u2019\u7684\u58F0\u97F3\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 2702ea2483e858947acce26fc5ed9006, type: 3}
    speakerId: 
    content: "\u5979\u7684\u624B\u7A7F\u8FC7\u955C\u9762\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 2702ea2483e858947acce26fc5ed9006, type: 3}
    speakerId: 
    content: "\u955C\u9762\u6CDB\u8D77\u6D9F\u6F2A\u3002\u5979\u7684\u624B\u4F38\u51FA\u6765\uFF0C\u94F6\u767D\u8272\u7684\u6307\u5C16\u5728\u7A7A\u6C14\u4E2D\u5FAE\u5FAE\u53D1\u5149\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 2702ea2483e858947acce26fc5ed9006, type: 3}
    speakerId: 
    content: "\u6211\u4F38\u51FA\u624B\uFF0C\u63E1\u4F4F\u5979\u7684\u624B\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 2702ea2483e858947acce26fc5ed9006, type: 3}
    speakerId: 
    content: "\u4E0D\u662F\u51C9\u7684\u3002\u662F\u6E29\u7684\u3002\u548C\u6211\u81EA\u5DF1\u7684\u4F53\u6E29\u4E00\u6A21\u4E00\u6837\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: a4e2e9911bb671e4abad6efb33af3634, type: 3}
    speakerId: 
    content: "\u5979\u4ECE\u955C\u4E2D\u8D70\u51FA\u6765\u3002\u94F6\u767D\u8272\u7684\u5149\u8292\u7B3C\u7F69\u7740\u5979\uFF0C\u4E5F\u7B3C\u7F69\u7740\u6211\u3002\u5979\u770B\u7740\u6211\uFF0C\u7B11\u4E86\u2014\u2014\u773C\u7736\u7EA2\u7EA2\u7684\uFF0C\u4F46\u7B11\u7740\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 2702ea2483e858947acce26fc5ed9006, type: 3}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u8C22\u8C22\u4F60\u6CA1\u6709\u5FD8\u8BB0\u6211\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: a4e2e9911bb671e4abad6efb33af3634, type: 3}
    speakerId: 
    content: "\u5979\u62E5\u62B1\u4E86\u6211\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: a4e2e9911bb671e4abad6efb33af3634, type: 3}
    speakerId: 
    content: "\u90A3\u4E2A\u62E5\u62B1\u5F88\u8F7B\uFF0C\u5F88\u77ED\u3002\u4F46\u90A3\u4E00\u77AC\u95F4\uFF0C\u6211\u611F\u89C9\u5230\u7684\u4E0D\u662F\u4E00\u4E2A\u4EBA\u7684\u6E29\u5EA6\u2014\u2014\u662F\u4E09\u80A1\u529B\u91CF\u540C\u65F6\u6D8C\u5165\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: edb284c9b543c50479448c0ba53f1f8b, type: 3}
    speakerId: 
    content: "\u4E00\u80A1\u6696\u91D1\u8272\uFF0C\u6765\u81EA\u5FC3\u5E95\u6700\u6DF1\u5904\uFF0C\u90A3\u662F\u4E94\u5C81\u7684\u81EA\u5DF1\uFF0C\u90A3\u4E2A\u6E34\u671B\u88AB\u7231\u7684\u5C0F\u5B69\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: edb284c9b543c50479448c0ba53f1f8b, type: 3}
    speakerId: 
    content: "\u4E00\u80A1\u94F6\u767D\u8272\uFF0C\u6765\u81EA\u6240\u6709\u5411\u5F80\u7684\u65B9\u5411\uFF0C\u90A3\u662F\u5979\uFF0C\u662F\u6211\u4E00\u76F4\u60F3\u6210\u4E3A\u7684\u4EBA\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: edb284c9b543c50479448c0ba53f1f8b, type: 3}
    speakerId: 
    content: "\u4E00\u80A1\u6697\u7070\u8272\uFF0C\u6765\u81EA\u521A\u521A\u6D88\u6563\u7684\u96FE\uFF0C\u90A3\u662F\u6240\u6709\u6211\u4E0D\u6562\u627F\u8BA4\u7684\u6050\u60E7\uFF0C\u662F\u6211\u4E00\u76F4\u9003\u907F\u7684\u81EA\u5DF1\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: edb284c9b543c50479448c0ba53f1f8b, type: 3}
    speakerId: 
    content: "\u5B83\u4EEC\u6CA1\u6709\u51B2\u7A81\uFF0C\u6CA1\u6709\u5BF9\u6297\u3002\u5B83\u4EEC\u53EA\u662F\u2026\u2026\u540C\u65F6\u5B58\u5728\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 24eeda6d6ca63f446bbc47db639f12fc, type: 3}
    speakerId: 
    content: "\u5979\u677E\u5F00\u624B\uFF0C\u770B\u7740\u6211\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 24eeda6d6ca63f446bbc47db639f12fc, type: 3}
    speakerId: "Kiaana\xB7Argent"
    content: "\u201C\u53BB\u5427\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 24eeda6d6ca63f446bbc47db639f12fc, type: 3}
    speakerId: "Kiaana\xB7Argent"
    content: "\u201C\u7EE7\u7EED\u8D70\u4E0B\u53BB\u3002\u201D"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 30c2264fa5808ba49a46a0c88086b1a9, type: 3}
    speakerId: 
    content: "\u7136\u540E\u5979\u6D88\u5931\u4E86\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 30c2264fa5808ba49a46a0c88086b1a9, type: 3}
    speakerId: 
    content: "\u4E0D\u662F\u6D88\u6563\uFF0C\u662F\u878D\u5408\u3002"
    useCGMode: 1
  - background: {fileID: 21300000, guid: 30c2264fa5808ba49a46a0c88086b1a9, type: 3}
    speakerId: 
    content: "\u662F\u56DE\u5230\u5979\u6765\u7684\u90A3\u4E2A\u5730\u65B9\u2014\u2014\u56DE\u5230\u6E0A\u5FC3\uFF0C\u56DE\u5230\u601D\u7F15\uFF0C\u56DE\u5230\u6BCF\u4E00\u4EF6\u7ECE\u8BED\u91CC\uFF0C\u56DE\u5230\u6211\u7684\u6BCF\u4E00\u6B21\u5FC3\u8DF3\u91CC\u3002"
    useCGMode: 1
