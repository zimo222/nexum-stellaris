  dialogueEntries:
  - background: {fileID: 0}
    speakerId: 
    content: "\u5728\u7EAF\u767D\u56DE\u5ECA\u8D70\u4E86\u5F88\u4E45\u3002"
  - background: {fileID: 0}
    speakerId: 
    content: "\u5979\u6559\u6211\u8FA8\u8BA4\u90A3\u4E9B\u5ECA\u67F1\u4E0A\u7684\u523B\u75D5\uFF0C\u544A\u8BC9\u6211\u54EA\u4E9B\u662F\u5371\u9669\u7684\u533A\u57DF\uFF0C\u5076\u5C14\u8BB2\u4E00\u4E9B\u5173\u4E8E\u5FC3\u8C61\u5947\u70B9\u7684\u6545\u4E8B\u3002\u5979\u7684\u58F0\u97F3\u5F88\u597D\u542C\uFF0C\u50CF\u98CE\u94C3\u3002"
  - background: {fileID: 0}
    speakerId: 
    content: "\u6211\u4EEC\u505C\u4E0B\u6765\u4F11\u606F\u3002\u6211\u9760\u5728\u5ECA\u67F1\u4E0A\uFF0C\u5979\u5750\u5728\u5BF9\u9762\uFF0C\u95ED\u7740\u773C\u775B\uFF0C\u597D\u50CF\u5728\u542C\u4EC0\u4E48\u3002"
  - background: {fileID: 0}
    speakerId: 
    content: "\u5F80\u524D\u8D70\u3002\u811A\u4E0B\u7684\u77F3\u677F\u5F88\u5149\u6ED1\uFF0C\u6620\u51FA\u6A21\u7CCA\u7684\u5012\u5F71\u3002\u5ECA\u67F1\u4E0A\u523B\u7740\u4E1C\u897F\uFF0C\u6709\u7684\u50CF\u6587\u5B57\uFF0C\u6709\u7684\u50CF\u753B\uFF0C\u4F46\u90FD\u592A\u65E7\u4E86\uFF0C\u770B\u4E0D\u6E05\u3002"
  - background: {fileID: 0}
    speakerId: 
    content: "\u8D70\u4E86\u5F88\u4E45\u3002"
  - background: {fileID: 0}
    speakerId: 
    content: "\u8D70\u5ECA\u6CA1\u6709\u5C3D\u5934\u3002\u505C\u4E0B\u6765\uFF0C\u56DB\u5904\u5F20\u671B\u3002\u6BCF\u4E00\u6839\u5ECA\u67F1\u90FD\u4E00\u6837\uFF0C\u6BCF\u4E00\u5BF8\u5149\u90FD\u4E00\u6837\u3002"
  - background: {fileID: 0}
    speakerId: "\uFF1F\uFF1F\uFF1F"
    content: "\u201C\u4F60\u8FF7\u8DEF\u4E86\u5417\uFF1F\u201D"
  - background: {fileID: 0}
    speakerId: 
    content: "\u4E00\u4E2A\u94F6\u767D\u957F\u53D1\u7684\u5C11\u5973\u7AD9\u5728\u5ECA\u67F1\u65C1\u3002\u6E5B\u84DD\u7684\u773C\u77B3\uFF0C\u94F6\u767D\u8272\u7684\u5934\u53D1\u88AB\u4E0D\u77E5\u4ECE\u54EA\u6765\u7684\u98CE\u5439\u8D77\u3002\u5979\u770B\u7740\u6211\uFF0C\u773C\u775B\u91CC\u6709\u5149\u3002"
  - background: {fileID: 0}
    speakerId: "Kianna\xB7Argent"
    content: "\u201C\u8FD9\u91CC\u662F\u7EAF\u767D\u56DE\u5ECA\u3002\u6211\u662F\u8FD9\u91CC\u7684\u89C2\u6D4B\u8005\u3002\u4F60\u53EF\u4EE5\u53EB\u6211\u2026\u2026\u7EAF\u767D\u3002\u201D"
  objectives: []
  waves: []
